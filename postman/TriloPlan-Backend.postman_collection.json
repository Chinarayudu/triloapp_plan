    {
      "name": "Auth — Login",
      "description": "Shared by the User app and the Host app — both apps hit the same endpoints, differing only in the `role` sent on first-ever verify for a phone number. Admin login (email/password) is a separate flow, not yet built (Phase 9). Run this folder top to bottom.",
      "item": [
        {
          "name": "1. Request OTP — User Phone",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "request"]
            },
            "description": "Sends a 6-digit OTP to `phone`. Rate-limited to 5 requests per 15 minutes per IP — you'll get a 429 if you spam this.\n\nIn non-production environments, the response includes `devCode` (the actual code) since no SMS provider is configured yet. Never rely on `devCode` being present in production."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.devCode) {",
                  "    pm.collectionVariables.set(\"devCode\", jsonData.devCode);",
                  "    console.log(\"Saved devCode:\", jsonData.devCode);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "OK (dev mode)",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876500001\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/otp/request", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "request"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"devCode\": \"108399\"\n}"
            },
            {
              "name": "Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"123\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/otp/request", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "request"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Too small: expected string to have >=8 characters\"\n}"
            }
          ]
        },
        {
          "name": "2. Verify OTP — User App",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{devCode}}\",\n  \"role\": \"user\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "verify"]
            },
            "description": "Verifies the OTP and logs in — creating a new USER account on first-ever verify for this phone number. `role` is only honored on brand-new signups; an existing account always keeps its original role, so this can't be used to escalate a user into a host or vice versa."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
                  "    pm.collectionVariables.set(\"userId\", jsonData.user.id);",
                  "    console.log(\"Logged in as\", jsonData.user.role, jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "OK — new or existing user",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876500001\",\n  \"code\": \"108399\",\n  \"role\": \"user\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "verify"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"accessToken\": \"<JWT access token, 15 min expiry>\",\n  \"refreshToken\": \"<opaque refresh token, 30 day expiry, single-use>\",\n  \"user\": {\n    \"id\": \"8e946734-1b08-4956-b4e1-bb96ddea0135\",\n    \"role\": \"user\",\n    \"phone\": \"9876500001\",\n    \"kycStatus\": \"not_submitted\"\n  }\n}"
            },
            {
              "name": "Incorrect code",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876500001\",\n  \"code\": \"000000\",\n  \"role\": \"user\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "verify"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"error\": \"Incorrect code\"\n}"
            },
            {
              "name": "No active OTP / expired / already used",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876500001\",\n  \"code\": \"108399\",\n  \"role\": \"user\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "verify"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"error\": \"No active OTP for this phone — request a new one\"\n}"
            }
          ]
        },
