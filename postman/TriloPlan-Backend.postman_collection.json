    { "key": "hostPhone", "value": "9876500555", "type": "string", "description": "Test phone number for the HOST-app login example. Kept separate from `phone` since each OTP is single-use and a phone number's role is locked in on first signup." },
    { "key": "devCode", "value": "", "type": "string", "description": "Auto-filled by 'Request OTP — User Phone' (dev-mode only)." },
    { "key": "hostDevCode", "value": "", "type": "string", "description": "Auto-filled by 'Request OTP — Host Phone' (dev-mode only)." },
    { "key": "accessToken", "value": "", "type": "string", "description": "Current session's access token — auto-filled by whichever Verify OTP / Refresh ran most recently." },
    { "key": "refreshToken", "value": "", "type": "string", "description": "Current session's refresh token — auto-filled by whichever Verify OTP / Refresh ran most recently." },
    { "key": "userId", "value": "", "type": "string", "description": "Current session's user id — auto-filled by Verify OTP." }
  ],
