    {
      "name": "Hosts — Discovery & Presence",
      "description": "Primarily consumed by the User app (browse/discover) and the Host app (presence toggle). `Toggle My Presence` is HOST-only.",
      "item": [
        {
          "name": "List Hosts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hosts?onlineOnly=true&sort=rate_asc&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["hosts"],
              "query": [
                { "key": "onlineOnly", "value": "true", "description": "true | false. Omit to show all active hosts regardless of presence." },
                { "key": "sort", "value": "rate_asc", "description": "One of: rate_asc, rate_desc, online_first. Omit for unsorted." },
                { "key": "page", "value": "1", "description": "1-indexed. Defaults to 1." },
                { "key": "pageSize", "value": "20", "description": "Max 50. Defaults to 20." }
              ]
            },
            "description": "Browse hosts available for calls/chat. Excludes suspended/banned host accounts automatically. Any authenticated account (user or host) can call this."
          },
          "response": [
            {
              "name": "OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/hosts?onlineOnly=true&pageSize=50", "host": ["{{baseUrl}}"], "path": ["hosts"], "query": [{ "key": "onlineOnly", "value": "true" }, { "key": "pageSize", "value": "50" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"hosts\": [\n    {\n      \"id\": \"db8147ca-70a8-4cb7-8c30-cc61e5703f0a\",\n      \"name\": null,\n      \"bio\": null,\n      \"gallery\": [],\n      \"ratePerMinutePaise\": 2500,\n      \"isOnline\": true\n    }\n  ],\n  \"total\": 1,\n  \"page\": 1,\n  \"pageSize\": 50\n}"
