    {
      "name": "Moderation",
      "item": [
        {
          "name": "1. Block User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/moderation/blocks", "host": ["{{baseUrl}}"], "path": ["moderation", "blocks"] },
            "description": "\"Block Rahul?\" confirmation. From this point on, calls/messages between the two are rejected."
          }
        },
        {
          "name": "2. List Blocked",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/moderation/blocks", "host": ["{{baseUrl}}"], "path": ["moderation", "blocks"] },
            "description": "Profile → Blocked creators screen."
          }
        },
        {
          "name": "3. Unblock User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/moderation/blocks/{{userId}}", "host": ["{{baseUrl}}"], "path": ["moderation", "blocks", "{{userId}}"] },
            "description": "Undoes step 1 so this collection can be re-run without a stale block."
          }
        },
        {
          "name": "4. File Report (Host)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"targetType\": \"user\",\n  \"targetId\": \"{{userId}}\",\n  \"reason\": \"Harassment or threats\"\n}" },
            "url": { "raw": "{{baseUrl}}/moderation/reports", "host": ["{{baseUrl}}"], "path": ["moderation", "reports"] },
            "description": "\"Report user\" screen's reason list maps to the free-text `reason` field."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set(\"reportId\", jsonData.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Log Capture Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"context\": \"call\",\n  \"contextId\": \"{{callId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/moderation/capture-event", "host": ["{{baseUrl}}"], "path": ["moderation", "capture-event"] },
            "description": "\"Screenshot blocked\" screen calls this to log the attempt."
          }
        }
      ]
    },
    {
      "name": "Auth — Session",
      "item": [
        {
          "name": "1. Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{hostRefreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/token/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "token", "refresh"] },
            "description": "\"Session expired / Log in again\" screen's underlying mechanism."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"hostAccessToken\", jsonData.accessToken);",
                  "    pm.collectionVariables.set(\"hostRefreshToken\", jsonData.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{hostRefreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "\"Logging Out?\" confirmation sheet."
          }
        }
      ]
    }
