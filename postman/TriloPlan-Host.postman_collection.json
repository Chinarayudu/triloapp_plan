        {
          "name": "3. Get Conversation Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations/{{chatConversationId}}/messages?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations", "{{chatConversationId}}", "messages"],
              "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "50" }]
            }
          }
        }
      ]
    },
    {
      "name": "Gifts",
      "item": [
        {
          "name": "1. List Gift Catalog",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/gifts", "host": ["{{baseUrl}}"], "path": ["gifts"] },
            "description": "\"Ask for a gift\" picker's catalog."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "var crown = jsonData.gifts.find(function (g) { return g.name === \"Crown\"; });",
                  "if (crown) { pm.collectionVariables.set(\"giftId\", crown.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Request Gift (Host asks User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hostAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"suggestedGiftId\": \"{{giftId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/gifts/request", "host": ["{{baseUrl}}"], "path": ["gifts", "request"] },
            "description": "\"Ask for a gift\" send action — a real-time prompt only, never moves money itself."
          }
        },
        {
          "name": "3. (User) Send Gift to This Host",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"recipientId\": \"{{hostId}}\",\n  \"giftId\": \"{{giftId}}\",\n  \"context\": \"chat\",\n  \"contextId\": \"{{chatConversationId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/gifts/send", "host": ["{{baseUrl}}"], "path": ["gifts", "send"] },
            "description": "Funds the host's bean balance so Withdrawals below has something to withdraw."
          }
        }
      ]
    },
