NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional — omit all three to fall back to dev-mode OTP logging (see src/lib/otpSender.ts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to "true" to actually send real SMS in development (default: dev-mode logging only,
# even with Twilio configured above). Always real in production. Never real in tests.
OTP_REAL_SMS_IN_DEV=false
# Optional — omit all four to disable object storage (KYC upload endpoints will 500 with a clear error)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
# Optional — omit both to fall back to a fake stub token (see src/lib/agoraToken.ts)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
