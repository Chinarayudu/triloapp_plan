NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The automated test suite (npm test) never reads this value — it always
# points at its own local Postgres instead (vitest.config.ts), so `npm run
# dev` and `npm test` can't accidentally write into the same database. See
# vitest.config.ts's DATABASE_URL comment for the one-time docker run setup.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional — omit all three to fall back to dev-mode OTP logging (see src/lib/otpSender.ts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to "true" to actually send real SMS in development (default: dev-mode logging only,
# even with Twilio configured above). Always real in production. Never real in tests.
OTP_REAL_SMS_IN_DEV=false
# Set to "true" to make POST /auth/otp/verify accept any phone + any 6-digit code (no real
# check, no prior /otp/request needed) — for frontend dev before real OTP delivery exists.
# Always off in production regardless of this value. Off by default.
OTP_BYPASS_VERIFICATION=false
# Optional — omit all four to disable object storage (KYC upload endpoints will 500 with a clear error)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
# Optional — only set this to point at an S3-compatible endpoint (e.g. a local MinIO container)
# instead of real AWS. Never set this in production. See .github/workflows/ci.yml for the CI setup.
AWS_S3_ENDPOINT=
# Optional — omit both to fall back to a fake stub token (see src/lib/agoraToken.ts)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional pair — TURN relay for "p2p" 1:1 calls (src/lib/iceServers.ts), from a Cloudflare
# Realtime TURN key (dash.cloudflare.com -> Realtime -> TURN). Unset = STUN only: most calls
# still connect directly, but ones behind strict NAT / carrier firewalls can't.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Optional pair — Agora RESTful API credentials (Agora console -> RESTful API -> Customer ID /
# Customer Secret). Only used when an admin turns on "ban the Agora channel when a call/broadcast
# ends" (src/lib/agoraChannel.ts). Unset = that switch logs a warning and does nothing.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Optional pair — Cloudflare Realtime SFU app (dash.cloudflare.com -> Realtime -> SFU), used only
# for live broadcasts when an admin switches live media to "cloudflare" (src/lib/cloudflareSfu.ts).
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
# Cashfree (src/lib/cashfree.ts). "sandbox" with test keys = fake money; NODE_ENV=production
# refuses to start unless this is "production". PG pair = wallet recharge + VIP checkout
# (merchant.cashfree.com -> Payment Gateway -> Developers -> API Keys). Unset = recharge/VIP use
# the dev-stub flow (dev-resolve endpoints) outside production.
CASHFREE_ENV=sandbox
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
# Payouts (host withdrawals) — separate product + keys (Payouts -> Developers -> API Keys), plus
# the 2FA public key file (Payouts -> Developers -> Two-Factor Authentication -> Public Key).
# Keep the .pem under secrets/ (gitignored) and point PATH at it — or, on hosts like Render, paste the
# PEM text into CASHFREE_PAYOUT_PUBLIC_KEY instead (
 escapes are fine). The 2FA method in the dashboard
# must be "Public Key", not IP whitelist. Payouts webhook URL (set in the Payouts dashboard, v2):
# <BACKEND_PUBLIC_URL>/payments/cashfree/payout-webhook
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_PUBLIC_KEY_PATH=./secrets/cashfree_payout_public.pem
CASHFREE_PAYOUT_PUBLIC_KEY=
# The User app's URL — where Cashfree returns the user after checkout.
USER_APP_URL=https://user-app-dating.vercel.app
# This backend's public https URL — Cashfree posts payment webhooks to
# <this>/payments/cashfree/webhook. Unset = payments are confirmed only when the app polls status.
BACKEND_PUBLIC_URL=https://triloapp-plan.onrender.com
# The platform's legal billing identity for the Host app invoice's "Billed to" box (GET /config's
# invoiceCompany). Set all three or none — null until then.
INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_GSTIN=
# Claude API key for the support-chat bot (platform.claude.com -> API keys). Unset = the bot never
# replies, even when switched on in admin; tickets wait for a person.
ANTHROPIC_API_KEY=
